<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RootNamespace>Haitch.Roslyn.PackageSmoke</RootNamespace>
        <AssemblyName>Consumer</AssemblyName>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Haitch.Roslyn ships as contentFiles and deliberately does not flow Microsoft.CodeAnalysis
             as a transitive dependency (PrivateAssets="all" on the source project); a real generator
             project brings its own Roslyn reference, so the consumer must too. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all"/>
        <!-- HaitchRoslynPackageVersion is supplied per run via -p: by PackageSmokeTests so the
             consumer always restores the freshly packed version, never a cached one. -->
        <PackageReference Include="Haitch.Roslyn" Version="$(HaitchRoslynPackageVersion)"/>
    </ItemGroup>

</Project>

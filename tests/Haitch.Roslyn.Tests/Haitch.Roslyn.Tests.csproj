  <ItemGroup>
    <PackageReference Include="TUnit" Version="0.90.45" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Haitch.Roslyn\Haitch.Roslyn.csproj" />
  </ItemGroup>

</Project>
